@model IEnumerable<Consulta>
@{
    ViewData["Title"] = "Minhas Consultas";
}

<h2>Minhas Consultas</h2>
<p>
    <a asp-action="Create" class="btn btn-primary">+ Nova Consulta</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Você ainda não possui consultas cadastradas.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(m => m.First().Especialidade)</th>
                <th>@Html.DisplayNameFor(m => m.First().DataHora)</th>
                <th>@Html.DisplayNameFor(m => m.First().Descricao)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Especialidade</td>
                    <td>@item.DataHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Descricao</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
